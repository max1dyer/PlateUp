# Copy this file to backend/.env and fill it in to turn on Supabase sign-in.
# With these left blank, PlateUp uses the development sign-in (username only, x-user-id header).
# Values: Supabase dashboard > Project Settings > API (and Data API / JWT Keys).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=
# Public "anon" key. Safe to share with browsers; the frontend gets it from GET /api/auth/config.
SUPABASE_ANON_KEY=
# Only for projects still using the legacy JWT secret (HS256). Leave blank if the project uses
# JWT signing keys; the backend then fetches them from SUPABASE_URL. Never commit this value.
SUPABASE_JWT_SECRET=
